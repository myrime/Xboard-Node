# Xboard Node Configuration
# Top-level settings are inherited by all instances. Instance overrides take precedence.

# ── Single node (simplest) ──
# panel:
#   url: "https://panel.example.com"
#   token: "your-api-key"
#   node_id: 1

# ── Multiple instances ──
# kernel:
#   type: "singbox"
#   # socks_udp_shared: false   # socks nodes only: relay socks5 UDP over the
#                               # node's own listen port (like Xray) instead of
#                               # random ephemeral ports, so only the node port
#                               # needs UDP reachability. UDP user attribution
#                               # is by source IP of the TCP associate.
#                               # DEFAULT: enabled — no need to set anything.
#                               # Set to false only to restore the legacy
#                               # per-associate random-port UDP behavior.
# log:
#   level: "info"
# instances:
#   - panel:
#       url: "https://panel.example.com"
#       token: "api-key-1"
#       node_id: 1
#   - panel:
#       url: "https://panel.example.com"
#     machine:
#       machine_id: 2
#       token: "machine-token-2"
#     log:
#       level: "debug"   # override for this instance only
